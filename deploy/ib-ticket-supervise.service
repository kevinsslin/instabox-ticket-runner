[Unit]
Description=Checkpoint completed Instabox coding turns
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/ib-ticket --config %h/.config/instabox-ticket-runner/config.yaml supervise
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
