[Unit]
Description=Private Instabox task dashboard
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ib-ticket --config %h/.config/instabox-ticket-runner/config.yaml serve --password-file %h/.config/instabox-ticket-runner/dashboard-password
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
